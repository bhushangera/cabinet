{
  "name": "cabinet-api",
  "version": "1.0.0",
  "description": "Cabinet API - Google Sheets Integration",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "NODE_ENV=development nodemon app.js",
    "test:full": "bash ./scripts/test-phases.sh --full",
    "test:phases": "bash ./scripts/test-phases.sh",
    "test:1-3": "bash ./scripts/test-phases.sh --phases 1-3",
    "test:4-6": "bash ./scripts/test-phases.sh --phases 4-6",
    "test:7-9": "bash ./scripts/test-phases.sh --phases 7-9",
    "test:10-12": "bash ./scripts/test-phases.sh --phases 10-12",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:dry": "bash ./scripts/deploy.sh --dry-run"
  },
  "keywords": ["cabinet", "google-sheets", "api", "nodejs"],
  "author": "Claude",
  "license": "Proprietary",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.3",
    "googleapis": "^118.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
