# Cabinet API - Google Sheets Integration
# Copy this file to .env and fill in actual values

# Server
NODE_ENV=production
PORT=3000
APP_URL=https://propulsive.co.in

# Database
MONGODB_URI=mongodb://localhost:27017/cabinetry
MONGODB_BACKUP_PATH=/var/backups/mongodb

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=

# Google Service Account (base64 encoded JSON key)
GOOGLE_SERVICE_ACCOUNT_B64=

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_IV=

# JWT
JWT_SECRET=
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/cabinet-api.log

# Monitoring
SENTRY_DSN=

# PM2
PM2_APP_NAME=cabinet-api
PM2_INSTANCES=max
